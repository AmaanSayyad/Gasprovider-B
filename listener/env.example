# BOT Chain — the source chain the escrow listens on.
BOTCHAIN_RPC_URL=https://rpc.botchain.ai

# GasProvider escrow address on BOT Chain (chainId 677).
# Set after `npm run deploy:botchain` in contracts/.
CONTRACT_ADDRESS_677=

# Optional: WebSocket endpoint. Preferred when available — HTTP polling relies
# on eth_newFilter, which some nodes evict.
# BOTCHAIN_WS_URL=

# Optional: polling interval for the HTTP provider (default 4000)
POLLING_INTERVAL_MS=3000

# Backend endpoint that receives the events
BACKEND_URL=http://localhost:3000/event
